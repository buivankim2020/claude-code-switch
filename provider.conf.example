# CCS - Claude Code Switch
# Provider configuration file
#
# Copy this file to ~/.ccs/provider.conf and fill in your API keys:
#   cp provider.conf.example ~/.ccs/provider.conf
#
# Format: INI-style sections. Each [section] is a profile name.
#
# PROVIDER_TYPE (optional, default=anthropic) selects the shape of the profile.
#
# Optional per-profile behavior:
#   CUSTOM_PROMPT=1                    Inject the CCS-managed custom prompt into
#                                      CLAUDE.md when this profile is active.
#                                      Missing or any value other than 1 = off.
#
# --- Type: anthropic (default) ---
# Required keys:
#   ANTHROPIC_AUTH_TOKEN
#   ANTHROPIC_BASE_URL
#   ANTHROPIC_DEFAULT_HAIKU_MODEL
#   ANTHROPIC_DEFAULT_OPUS_MODEL
#   ANTHROPIC_DEFAULT_SONNET_MODEL
#
# --- Type: foundry (Microsoft Azure Foundry) ---
# Required keys:
#   PROVIDER_TYPE=foundry
#   ANTHROPIC_FOUNDRY_RESOURCE        Azure resource name, URL is derived as
#                                     https://<resource>.services.ai.azure.com/anthropic
#     -- OR --
#   ANTHROPIC_FOUNDRY_BASE_URL        Full base URL if you need a custom host
#   ANTHROPIC_FOUNDRY_API_KEY         Foundry project API key
#   ANTHROPIC_DEFAULT_HAIKU_MODEL     Deployment name, e.g. claude-haiku-4-5
#   ANTHROPIC_DEFAULT_OPUS_MODEL      Deployment name, e.g. claude-opus-4-6
#   ANTHROPIC_DEFAULT_SONNET_MODEL    Deployment name, e.g. claude-sonnet-4-6

[opus]
ANTHROPIC_AUTH_TOKEN=sk-ant-your-anthropic-key-here
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_DEFAULT_HAIKU_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_DEFAULT_OPUS_MODEL=claude-opus-4-6-20250414
ANTHROPIC_DEFAULT_SONNET_MODEL=claude-sonnet-4-6-20250514

[kimi]
ANTHROPIC_AUTH_TOKEN=sk-your-kimi-key-here
ANTHROPIC_BASE_URL=https://api.kimi.ai/v1
ANTHROPIC_DEFAULT_HAIKU_MODEL=kimi-latest
ANTHROPIC_DEFAULT_OPUS_MODEL=kimi-latest
ANTHROPIC_DEFAULT_SONNET_MODEL=kimi-latest

[foundry]
PROVIDER_TYPE=foundry
ANTHROPIC_FOUNDRY_RESOURCE=your-foundry-resource
ANTHROPIC_FOUNDRY_API_KEY=your-foundry-api-key
ANTHROPIC_DEFAULT_HAIKU_MODEL=claude-haiku-4-5
ANTHROPIC_DEFAULT_OPUS_MODEL=claude-opus-4-6
ANTHROPIC_DEFAULT_SONNET_MODEL=claude-sonnet-4-6
